{
  "name": "dsh-imagora-desk",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：把 Imagora 的自由画布搬进 DSH —— 提示词卡与图片摊在一张无限画布上，连线即参考关系。",
  "type": "module",
  "main": "src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "smoke": "node scripts/smoke-host.mjs && node scripts/smoke-client.mjs",
    "harness": "node scripts/build-harness-vendor.mjs && node scripts/harness-server.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "imagora",
    "canvas",
    "image-generation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cslkkl/dsh-imagora-desk.git"
  },
  "homepage": "https://github.com/cslkkl/dsh-imagora-desk#readme",
  "bugs": "https://github.com/cslkkl/dsh-imagora-desk/issues",
  "files": [
    "src",
    "dist",
    "build.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
