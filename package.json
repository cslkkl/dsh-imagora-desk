{
  "name": "dsh-imagora-desk",
  "version": "0.1.0",
  "description": "DeepSeek 插件：把 Imagora 的自由画布搬进 DSH —— 提示词卡与图片摊在一张无限画布上，连线即参考关系。",
  "type": "module",
  "main": "src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "node build.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke-host.mjs && node scripts/smoke-client.mjs && node scripts/check-market-index.mjs",
    "harness": "node scripts/build-harness-vendor.mjs && node scripts/harness-server.mjs",
    "market:index": "node scripts/build-market-index.mjs",
    "market:check": "node scripts/check-market-index.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "imagora",
    "canvas",
    "image-generation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cslkkl/dsh-imagora-desk.git"
  },
  "homepage": "https://github.com/cslkkl/dsh-imagora-desk#readme",
  "bugs": "https://github.com/cslkkl/dsh-imagora-desk/issues",
  "files": [
    "src",
    "dist",
    "build.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@xyflow/react": "12.11.2",
    "esbuild": "0.25.12",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "^16.5.0",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.1"
  }
}
