# 构建产物：dist/client.js 要进仓库（它就是浏览器半端），只忽略本地生成的 vendor
harness/dist/
*.tgz
*.log
harness/*.out
harness/*.err

# 依赖
node_modules/
.venv/

# 密钥与本机状态：插件不往仓库里写这些，条目只是防御
.env
.env.*
!.env.example
.agent/
.playwright-mcp/
# 共用模式如果被误指到仓库根，会在这里落 .assets / workflows（本机状态，不能进仓库）
/output/

# 系统 / 编辑器
.DS_Store
Thumbs.db
desktop.ini
